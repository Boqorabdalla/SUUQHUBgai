rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure helper functions definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperadminEmail() {
      return isSignedIn() && 
             request.auth.token != null && 
             request.auth.token.email != null && 
             request.auth.token.email.matches('(?i)^boqorapps@gmail\\.com$');
    }

    function isVendorOrAdmin() {
      return isSignedIn() && (
        isSuperadminEmail() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendor'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
          )
        )
      );
    }

    function isAdminOrSuperadmin() {
      return isSignedIn() && (
        isSuperadminEmail() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
          )
        )
      );
    }

    // 2. User Accounts collection path
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isSuperadminEmail() || resource.data.role == 'admin' || resource.data.role == 'superadmin');
      allow create: if isSignedIn() && (isOwner(userId) || isSuperadminEmail()) 
        && request.resource.data.keys().hasAll(['id', 'email', 'name', 'role']) 
        && request.resource.data.id == userId
        && (
          request.resource.data.role == 'customer'
          || request.resource.data.role == 'vendor'
          || request.resource.data.role == 'admin'
          || (request.resource.data.role == 'superadmin' && request.resource.data.email != null && request.resource.data.email.matches('(?i)^boqorapps@gmail\\.com$'))
          || isSuperadminEmail()
        );
      allow update: if isSignedIn() && (isOwner(userId) || isSuperadminEmail())
        && (isSuperadminEmail() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'id', 'email']));
      allow delete: if isSuperadminEmail();
    }

    // 3. Products Catalogue
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn()
        && (
          isSuperadminEmail()
          || (
            request.resource.data.keys().hasAll(['id', 'title', 'price', 'category', 'stock', 'isApproved'])
            && (
              request.resource.data.isApproved == false
              || (
                request.resource.data.vendorId != null
                && request.resource.data.vendorId is string
                && exists(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId))
                && 'bypassProductApproval' in get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data
                && get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.bypassProductApproval == true
              )
            )
            && request.resource.data.price is number
            && request.resource.data.price >= 0
          )
        );
      allow update: if isSignedIn()
        && (
          isAdminOrSuperadmin()
          || (
            (resource.data.vendorId == request.auth.uid)
            && (
              request.resource.data.isApproved == resource.data.isApproved
              || (
                exists(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
                && 'bypassProductApproval' in get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data
                && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.bypassProductApproval == true
              )
            )
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'vendorId'])
          )
        );
      allow delete: if isSignedIn() && (isAdminOrSuperadmin() || resource.data.vendorId == request.auth.uid);
    }

    // 4. Purchasing Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.customerRole == 'admin' || isVendorOrAdmin());
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.customerId == request.auth.uid || isVendorOrAdmin());
      allow delete: if false;
    }

    // 5. Merchant Sellers directory
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && (
          isAdminOrSuperadmin()
          || (
            (request.auth.uid == vendorId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'bypassProductApproval', 'earnings', 'id'])
          )
        );
      allow delete: if false;
    }

    // 6. Global Configs
    match /config/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 7. Coupons Database
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 7.5. Categories Collection (fixing Hostinger / direct client-side CRUD)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 8. Support Tickets
    match /support-tickets/{ticketId} {
      allow read, write: if isSignedIn();
    }

    // 9. Hero Banner Campaigns
    match /hero-campaigns/{campaignId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
